# Core algebraic identities and simple function facts.
# Syntax: [name:] left-hand-side => right-hand-side [if condition]

# Commutativity and associativity.
add-comm: a + b => b + a
add-assoc: (a + b) + c => a + (b + c)
mul-comm: a * b => b * a

# Additive identities.
add-zero: a + 0 => a
zero-add: 0 + a => a
sub-zero: a - 0 => a
sub-self: a - a => 0
add-self: a + a => 2 * a

# Multiplicative identities.
mul-zero: a * 0 => 0
zero-mul: 0 * a => 0
mul-one: a * 1 => a
one-mul: 1 * a => a
div-one: a / 1 => a
div-self: a / a => 1 if a != 0
zero-div: 0 / a => 0 if a != 0

# Negation.
neg-neg: -(-a) => a
add-neg: a + (-b) => a - b
sub-neg: a - (-b) => a + b
neg-mul-left: (-a) * b => -(a * b)
neg-mul-right: a * (-b) => -(a * b)

# Powers.
pow-zero: a ^ 0 => 1 if a != 0
pow-one: a ^ 1 => a
one-pow: 1 ^ a => 1
mul-pow: a * a => a ^ 2

# Distributed / expanded forms.
distribute: a * (b + c) => a * b + a * c
distribute-right: (a + b) * c => a * c + b * c
expand-square: (a + b) ^ 2 => a ^ 2 + 2 * a * b + b ^ 2
expand-square-diff: (a - b) ^ 2 => a ^ 2 - 2 * a * b + b ^ 2
expand-cube: (a + b) ^ 3 => a ^ 3 + 3 * a ^ 2 * b + 3 * a * b ^ 2 + b ^ 3
expand-cube-diff: (a - b) ^ 3 => a ^ 3 - 3 * a ^ 2 * b + 3 * a * b ^ 2 - b ^ 3

# Factored forms.
factor: a * b + a * c => a * (b + c)
factor-right: b * a + c * a => (b + c) * a
factor-sub: a * b - a * c => a * (b - c)
factor-right-sub: b * a - c * a => (b - c) * a

# Constant function facts.
sin-zero: sin(0) => 0
cos-zero: cos(0) => 1
tan-zero: tan(0) => 0
exp-zero: exp(0) => 1
ln-one: ln(1) => 0
log-one: log(1) => 0
log2-one: log2(1) => 0
log10-one: log10(1) => 0
sqrt-zero: sqrt(0) => 0
sqrt-one: sqrt(1) => 1
abs-zero: abs(0) => 0

# Function identities.
abs-abs: abs(abs(a)) => abs(a)
abs-neg: abs(-a) => abs(a)
sin-neg: sin(-a) => -sin(a)
cos-neg: cos(-a) => cos(a)
exp-ln: exp(ln(a)) => a
ln-exp: ln(exp(a)) => a
sqrt-square: sqrt(a ^ 2) => abs(a)
trig-identity: sin(a) ^ 2 + cos(a) ^ 2 => 1
